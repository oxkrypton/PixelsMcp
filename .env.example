# ── Required ──────────────────────────────────────────────
PIXELSMCP_API_KEY=your-api-key
PIXELSMCP_BASE_URL=https://api.example.com

# ── Provider & Model ──────────────────────────────────────
# PIXELSMCP_PROVIDER=openai-compatible   # default, also accepts "openai"
# PIXELSMCP_MODEL=your-model             # default
# PIXELSMCP_REFERENCE_MODEL=your-model   # used only when reference_image is provided

# ── Transport ─────────────────────────────────────────────
# PIXELSMCP_TRANSPORT=http               # default, also accepts "stdio"

# ── HTTP server (only when transport=http) ────────────────
# PIXELSMCP_ADDR=:8080                   # default
# PIXELSMCP_ENDPOINT=/mcp                # default
# PIXELSMCP_HEALTH_ENDPOINT=/healthz     # default
# PIXELSMCP_CORS_ORIGINS=                # comma-separated, e.g. https://example.com

# ── Request ───────────────────────────────────────────────
# PIXELSMCP_TIMEOUT=2m                   # default, accepts: 30s, 1m, 90s, etc.
# PIXELSMCP_EXTRA_HEADERS=               # key=value, comma/semicolon/newline separated
#                                        # also accepts JSON: {"X-Custom":"val"}

# ── Image Output ─────────────────────────────────────────
# PIXELSMCP_IMAGE_SAVE_DIR=./generated-images  # default
